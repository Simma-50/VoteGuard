# Gmail SMTP credentials for email-based OTP delivery (Nodemailer).
#
# GMAIL_USER must be a full Gmail address.
# GMAIL_APP_PASSWORD must be a 16-character Gmail "App Password" —
# NOT your normal Gmail password. Generate one at:
#   https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the Google account.)
#
# Copy this file to ".env" and fill in real values:
#   cp .env.example .env
#
# If these are left blank, VoteGuard still runs — OTP codes are simply
# printed to the server console instead of emailed, so the app remains
# usable without any SMTP setup.

GMAIL_USER=
GMAIL_APP_PASSWORD=
